{
  "name": "ohoney-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "ohoney order and enquiry API; also serves the prerendered storefront in production",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "test": "node --test --test-concurrency=1 'test/**/*.test.js'",
    "orders": "node --env-file-if-exists=.env scripts/orders.js"
  },
  "dependencies": {
    "@ohoney/shared": "file:../shared",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "8.7.1",
    "helmet": "8.3.0",
    "mongoose": "^8.23.0",
    "nodemailer": "10.0.15"
  },
  "devDependencies": {
    "supertest": "7.3.1"
  }
}
