# Copy to backend/.env for local development. Never commit real values.
# In production, set these in your host's environment settings instead.

NODE_ENV=development
PORT=8787
# Public address of the site, used in customer emails.
SITE_URL=http://localhost:5173

# MongoDB connection string (MongoDB Atlas or self-hosted). Required in production.
# Without it, development keeps orders in memory and loses them on restart.
MONGODB_URI=

# Email (SMTP). Required in production so the business is told about every order.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Sender address, e.g. "ohoney <orders@ohoney.in>"
MAIL_FROM=
# Inbox that receives new orders and enquiries.
ORDER_NOTIFY_EMAIL=

# Serve the built storefront (frontend/dist) from this server. Defaults to true in production.
SERVE_STATIC=
STATIC_DIR=
# Only needed if the storefront is hosted on a different domain from the API.
CORS_ORIGINS=
# Number of proxies in front of the app (1 on Render/Railway/Fly). Defaults to 1 in production.
TRUST_PROXY=

# Razorpay online payments. Leave disabled until the client's account is approved.
PAYMENTS_RAZORPAY_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Escape hatch for a private staging site without email. Never use in production.
ALLOW_NO_EMAIL=false
LOG_LEVEL=info
