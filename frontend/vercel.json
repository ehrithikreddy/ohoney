{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci && npm ci --prefix ../backend --omit=dev",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "trailingSlash": false,
  "regions": ["bom1"],
  "functions": {
    "api/index.js": { "maxDuration": 30 }
  },
  "rewrites": [{ "source": "/api/(.*)", "destination": "/api" }],
  "redirects": [
    { "source": "/product/p1", "destination": "/shop/wildflower-honey", "permanent": true },
    { "source": "/product/p2", "destination": "/shop/forest-honey", "permanent": true },
    { "source": "/product/p3", "destination": "/shop/eucalyptus-honey", "permanent": true },
    { "source": "/product/p4", "destination": "/shop/honey-sampler", "permanent": true },
    { "source": "/product/:id", "destination": "/shop", "permanent": true }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self'; style-src-attr 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-src 'none'; form-action 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests"
        },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ]
}
