# Build-time settings for the storefront (copy to frontend/.env.local if needed).
# These values are public: they end up in the browser bundle. Never put secrets here.

# Canonical site address, used for canonical URLs, Open Graph tags and the sitemap.
VITE_SITE_URL=https://www.ohoney.in
# Only if the API is on a different domain, e.g. https://api.ohoney.in. Leave empty when one server serves both.
VITE_API_URL=
# Set to true for staging/client-review builds so search engines don't index them.
VITE_NOINDEX=false
